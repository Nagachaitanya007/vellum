# Vellum standalone production configuration
# Copy to `.env` (never commit `.env`). Restart the dev server after changes.

# Public origin of this app, no trailing slash.
# Google OAuth redirect is: {BETTER_AUTH_URL}/api/auth/callback/google
# Required on Vercel / any host. Example: https://vellum.vercel.app
BETTER_AUTH_URL=http://localhost:8080

# Random secret used to sign sessions. Required in production.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud OAuth 2.0 Web client (you own this).
# Authorized JavaScript origins:  {BETTER_AUTH_URL}
# Authorized redirect URI:        {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Turso (libSQL) — production source of truth for users and notes.
# Required on Vercel. Locally, omit both to use file:.data/vellum.db
#   turso db create vellum
#   turso db show vellum --url
#   turso db tokens create vellum
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=

# Optional aliases (same meaning as TURSO_*):
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# Sign-in UI. Must be "true" (or omitted) at **build** time on Vercel.
# "false" hides Google and keeps notes on-device only.
VITE_AUTH_ENABLED=true
